<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.tetoo.gui.controllers.ChatController">
    
    <Label text="Chats" styleClass="section-title" />
    
    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <!-- Left: Conversations List -->
        <VBox prefWidth="300" spacing="10.0">
            <Label text="Conversations" styleClass="subsection-title" />
            <ListView fx:id="chatsListView" VBox.vgrow="ALWAYS" 
                      style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 5;" />
        </VBox>
        
        <!-- Middle: Chat Area (visible when chat selected) -->
        <VBox fx:id="chatArea" spacing="10.0" HBox.hgrow="ALWAYS" visible="false">
            <!-- Chat Header -->
            <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-background-color: #F9F9F9; -fx-border-radius: 5;">
                <Circle radius="20" fill="LIGHTGRAY" />
                <VBox spacing="2">
                    <Label fx:id="chatPartnerNameLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                    <Label fx:id="chatPartnerInfoLabel" style="-fx-text-fill: #666666;" />
                </VBox>
            </HBox>
            
            <!-- Messages History -->
            <ListView fx:id="messagesListView" VBox.vgrow="ALWAYS" 
                      style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 5;" />
            
            <!-- Message Input -->
            <HBox spacing="10.0" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                <TextArea fx:id="messageInputArea" HBox.hgrow="ALWAYS" 
                          promptText="Type your message here..."
                          style="-fx-pref-height: 60; -fx-background-radius: 5; -fx-border-radius: 5;" />
                <Button fx:id="sendMessageButton" text="Send" 
                        style="-fx-background-color: #8A2BE2; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-border-radius: 5;" />
            </HBox>
        </VBox>
        
        <!-- Right: No Chat Selected Pane -->
        <VBox fx:id="noChatSelectedPane" alignment="CENTER" HBox.hgrow="ALWAYS">
            <Label text="Select a conversation to start messaging" 
                   style="-fx-font-size: 16px; -fx-text-fill: #666666;" />
            <Label text="Or start a new chat from Matches" 
                   style="-fx-font-size: 14px; -fx-text-fill: #888888; -fx-padding: 10 0 0 0;" />
        </VBox>
    </HBox>
</VBox>