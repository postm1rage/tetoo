<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.shape.Circle?>

<StackPane fx:id="mainChatPane" xmlns="http://javafx.com/javafx/17" 
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.tetoo.gui.controllers.ChatController"
           style="-fx-background-color: #fff5f7;">
    
    <!-- Основной контейнер -->
    <HBox fx:id="chatMainContainer" spacing="0" StackPane.alignment="CENTER">
        
        <!-- ЛЕВАЯ ПАНЕЛЬ: Список диалогов -->
        <VBox prefWidth="300" minWidth="250" maxWidth="350" 
              style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 0);">
            
            <!-- Заголовок Conversations -->
            <VBox alignment="CENTER_LEFT" 
                  style="-fx-background-color: #fff5f7; -fx-padding: 20 20 15 20;">
                <Label text="Conversations" 
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333333;" />
                <Label text="Your active conversations" 
                       style="-fx-font-size: 13px; -fx-text-fill: #888888; -fx-padding: 5 0 0 0;" />
            </VBox>
            
            <!-- Список диалогов -->
            <ListView fx:id="chatsListView" VBox.vgrow="ALWAYS" 
                      style="-fx-background-color: transparent; -fx-border-width: 0;" />
        </VBox>
        
        <!-- ЦЕНТРАЛЬНАЯ ПАНЕЛЬ: Область чата -->
        <VBox fx:id="chatArea" HBox.hgrow="ALWAYS" visible="false"
              style="-fx-background-color: #fff5f7;">
            
            <!-- Заголовок чата с собеседником -->
            <HBox alignment="CENTER_LEFT" 
                  style="-fx-background-color: white; -fx-padding: 15 25; -fx-border-color: #f0f0f0; -fx-border-width: 0 0 1px 0;">
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Circle radius="22" fill="#ec4b6e" />
                    <VBox spacing="2">
                        <Label fx:id="chatPartnerNameLabel" 
                               text="Select a conversation"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333333;" />
                        <Label fx:id="chatPartnerInfoLabel" 
                               text="Start messaging"
                               style="-fx-font-size: 14px; -fx-text-fill: #666666;" />
                    </VBox>
                </HBox>
            </HBox>
            
            <!-- История сообщений -->
            <ListView fx:id="messagesListView" VBox.vgrow="ALWAYS" 
                      style="-fx-background-color: #fff5f7; -fx-border-width: 0; -fx-padding: 10 0;" />
            
            <!-- Поле ввода сообщения -->
            <HBox alignment="CENTER" 
                  style="-fx-background-color: white; -fx-padding: 15 25; -fx-border-color: #f0f0f0; -fx-border-width: 1px 0 0 0;">
                <TextArea fx:id="messageInputArea" HBox.hgrow="ALWAYS" 
                          promptText="Type your message..."
                          style="-fx-pref-height: 50; -fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 12 20; -fx-font-size: 14px;" />
                <Button fx:id="sendMessageButton" text="Send" 
                        style="-fx-background-color: linear-gradient(to right, #ec4b6e, #ff6b9d); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 12 30; -fx-border-radius: 20; -fx-background-radius: 20; -fx-cursor: hand; -fx-margin: 0 0 0 15;"
                        onMouseEntered="#onSendButtonHover" onMouseExited="#onSendButtonExit" />
            </HBox>
        </VBox>
        
        <!-- Правая панель: Чат не выбран (пустой фон) -->
        <VBox fx:id="noChatSelectedPane" alignment="CENTER" HBox.hgrow="ALWAYS" visible="true"
              style="-fx-background-color: #fff5f7;">
            <VBox alignment="CENTER" spacing="20">
                <Circle radius="60" fill="#f0f0f0" />
                <VBox alignment="CENTER" spacing="8">
                    <Label text="No conversation selected" 
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #666666;" />
                    <Label text="Select a conversation from the list to start messaging" 
                           style="-fx-font-size: 14px; -fx-text-fill: #888888; -fx-text-alignment: center; -fx-max-width: 300;" />
                </VBox>
            </VBox>
        </VBox>
        
    </HBox>
</StackPane>