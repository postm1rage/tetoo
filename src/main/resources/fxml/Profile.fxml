<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane fx:id="mainPane" prefHeight="700.0" prefWidth="1000.0" stylesheets="@../styles/profile.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.tetoo.gui.controllers.ProfileController">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" styleClass="top-bar">
            <ImageView fitHeight="40.0" fitWidth="40.0" preserveRatio="true">
                <Image url="@../images/tetoo_logo_small.png" />
            </ImageView>
            <Label styleClass="app-title" text="TETOO" />
            <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                <Label fx:id="welcomeLabel" styleClass="welcome-text" />
                <Button mnemonicParsing="false" onAction="#handleBackToDashboard" styleClass="nav-btn" text="Back to menu" />
            </HBox>
        </HBox>
    </top>

    <!-- Main Content -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="30.0" styleClass="profile-container">
                <padding>
                    <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                </padding>

                <!-- Profile Header -->
                <HBox alignment="TOP_LEFT" spacing="30.0">
                    <!-- Avatar Section -->
                    <VBox alignment="CENTER" spacing="15.0">
                        <StackPane>
                            <Circle fill="#ec4b6e" radius="70" />
                            <ImageView fitHeight="120" fitWidth="120" preserveRatio="true" styleClass="avatar-image">
                                <Image url="@../images/default_avatar.png" />
                            </ImageView>
                        </StackPane>
                        <Button fx:id="changeAvatarBtn" mnemonicParsing="false" styleClass="secondary-btn" text="Change Photo">
                            <graphic>
                                <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                                    <Image url="@../icons/camera_icon.png" />
                                </ImageView>
                            </graphic>
                        </Button>
                    </VBox>

                    <!-- Basic Info -->
                    <VBox spacing="10.0" styleClass="basic-info-section">
                        <Label styleClass="profile-title" text="Create Your Profile" />
                        <Label styleClass="info-text" text="Fill in your details to get the best experience" />
                        <Label fx:id="verifiedBadge" styleClass="verified-badge" text="Complete your profile to get verified" visible="false" />
                    </VBox>
                </HBox>

                <!-- Edit Profile Section -->
                <VBox spacing="25.0" styleClass="edit-section">
                    <Label styleClass="section-title" text="Profile Information" />

                    <!-- Personal Information -->
                    <VBox spacing="15.0" styleClass="form-section">
                        <Label styleClass="subsection-title" text="Personal Information" />
                        <GridPane hgap="20" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints prefWidth="150" />
                                <ColumnConstraints prefWidth="300" />
                            </columnConstraints>

                            <!-- Full Name -->
                            <Label styleClass="form-label" text="Full Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <TextField fx:id="fullNameField" promptText="Enter your full name" styleClass="form-input" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                            <!-- Age -->
                            <Label styleClass="form-label" text="Age:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <TextField fx:id="ageField" promptText="Enter your age" styleClass="form-input" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                            <!-- City -->
                            <Label styleClass="form-label" text="City:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <TextField fx:id="cityField" promptText="Enter your city" styleClass="form-input" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                            <!-- Gender -->
                            <Label styleClass="form-label" text="Gender:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                            <ComboBox fx:id="genderComboBox" styleClass="form-combo" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                            <rowConstraints>
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                            </rowConstraints>
                        </GridPane>
                    </VBox>

                    <!-- About Me Section -->
                    <VBox spacing="15.0" styleClass="form-section">
                        <Label styleClass="subsection-title" text="About Me" />
                        <TextArea fx:id="aboutMeTextArea" promptText="Tell us about yourself..." styleClass="about-me-textarea" wrapText="true" />
                        <Label styleClass="hint-text" text="Describe your personality, interests, and what you're looking for" />
                    </VBox>

                    <!-- Preferences -->
                    <VBox spacing="15.0" styleClass="form-section">
                        <Label styleClass="subsection-title" text="Preferences" />
                        <GridPane hgap="20" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints prefWidth="150" />
                                <ColumnConstraints prefWidth="300" />
                            </columnConstraints>

                            <!-- Looking For -->
                            <Label styleClass="form-label" text="Looking For:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <ComboBox fx:id="relationshipGoalComboBox" styleClass="form-combo" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                            <!-- Interests -->
                            <Label styleClass="form-label" text="Interests:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <TextField fx:id="interestsField" promptText="e.g., Music, Travel, Sports, Art" styleClass="form-input" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                            <rowConstraints>
                                <RowConstraints />
                                <RowConstraints />
                            </rowConstraints>
                        </GridPane>
                    </VBox>

                    <!-- Action Buttons -->
                    <HBox alignment="CENTER_RIGHT" spacing="15.0">
                        <Button fx:id="cancelBtn" mnemonicParsing="false" styleClass="cancel-btn" text="Cancel" />
                        <Button fx:id="saveBtn" mnemonicParsing="false" styleClass="save-btn" text="Save Profile" />
                    </HBox>
                </VBox>

                <!-- Profile Stats (скрыто до создания профиля) -->
                <VBox spacing="20.0" styleClass="stats-section" visible="false">
                    <Label styleClass="section-title" text="Profile Stats" />
                    <HBox alignment="CENTER" spacing="30.0">
                        <VBox alignment="CENTER" spacing="5.0" styleClass="stat-box">
                            <Label fx:id="likesCount" styleClass="stat-number" text="0" />
                            <Label styleClass="stat-label" text="Likes" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="5.0" styleClass="stat-box">
                            <Label fx:id="matchesCount" styleClass="stat-number" text="0" />
                            <Label styleClass="stat-label" text="Matches" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="5.0" styleClass="stat-box">
                            <Label fx:id="visitsCount" styleClass="stat-number" text="0" />
                            <Label styleClass="stat-label" text="Profile Visits" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="5.0" styleClass="stat-box">
                            <Label fx:id="responseRate" styleClass="stat-number" text="0%" />
                            <Label styleClass="stat-label" text="Response Rate" />
                        </VBox>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <!-- Bottom Status Bar -->
    <bottom>
        <HBox alignment="CENTER" prefHeight="30.0" styleClass="status-bar">
            <Label fx:id="statusLabel" styleClass="status-text" text="Ready" />
        </HBox>
    </bottom>

</BorderPane>
