<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane fx:id="mainPane" prefHeight="700.0" prefWidth="1000.0" stylesheets="@../styles/dashboard.css, @../styles/matches.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.tetoo.gui.controllers.MatchesController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" styleClass="top-bar">
            <ImageView fitHeight="40.0" fitWidth="40.0" preserveRatio="true">
                <Image url="@../images/tetoo_logo_small.png" />
            </ImageView>
            <Label styleClass="app-title" text="TETOO" />
            <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                <Label fx:id="welcomeLabel" styleClass="welcome-text" />
                <Button mnemonicParsing="false" onAction="#handleBackToDashboard" styleClass="nav-btn" text="Back to menu" />
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="30" styleClass="matches-container">
                <padding>
                    <Insets bottom="30" left="30" right="30" top="30" />
                </padding>

                <!-- Matches Header -->
                <VBox spacing="15" styleClass="matches-header">
                    <Label styleClass="section-title" text="Your Matches" />
                    <Label styleClass="info-text" text="People you've mutually liked and connected with" />
                </VBox>

                <!-- Stats Overview -->
                <HBox alignment="CENTER" spacing="40" style="-fx-background-color: #ec4b6e;" styleClass="matches-stats">
                    <VBox alignment="CENTER" spacing="8" styleClass="stat-item">
                        <Label styleClass="stat-number" text="5" />
                        <Label styleClass="stat-label" text="Total Matches" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="8" styleClass="stat-item">
                        <Label styleClass="stat-number" text="2" />
                        <Label styleClass="stat-label" text="New This Week" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="8" styleClass="stat-item">
                        <Label styleClass="stat-number" text="80%" />
                        <Label styleClass="stat-label" text="Response Rate" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="8" styleClass="stat-item">
                        <Label styleClass="stat-number" text="3" />
                        <Label styleClass="stat-label" text="Active Now" />
                    </VBox>
                </HBox>

                <!-- Matches Grid -->
                <GridPane styleClass="matches-grid-container">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33" />
                        <ColumnConstraints percentWidth="33" />
                        <ColumnConstraints percentWidth="33" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>

                    <!-- Match 1 -->
                    <VBox spacing="15" styleClass="match-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <StackPane styleClass="match-avatar-container">
                            <Circle fill="#ec4b6e" radius="60" />
                            <ImageView fitHeight="100" fitWidth="100" preserveRatio="true" styleClass="match-avatar" />
                            <Circle fill="#4CAF50" radius="10" styleClass="online-indicator" StackPane.alignment="BOTTOM_RIGHT" />
                        </StackPane>
                        <VBox spacing="8" styleClass="match-info">
                            <Label styleClass="match-name" text="Emma Wilson" />
                            <Label styleClass="match-time" text="Matched Today" />
                            <Label styleClass="match-interests" text="Artist, Traveler, Coffee Lover" wrapText="true" />
                        </VBox>
                        <HBox spacing="12" styleClass="match-actions">
                            <Button styleClass="match-action-btn" text="Message" HBox.hgrow="ALWAYS" />
                            <Button styleClass="match-secondary-btn" text="Profile" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>

                    <!-- Match 2 -->
                    <VBox spacing="15" styleClass="match-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <StackPane styleClass="match-avatar-container">
                            <Circle fill="#2196F3" radius="60" />
                            <ImageView fitHeight="100" fitWidth="100" preserveRatio="true" styleClass="match-avatar" />
                        </StackPane>
                        <VBox spacing="8" styleClass="match-info">
                            <Label styleClass="match-name" text="David Chen" />
                            <Label styleClass="match-time" text="Matched 2 days ago" />
                            <Label styleClass="match-interests" text="Developer, Hiker, Foodie" wrapText="true" />
                        </VBox>
                        <HBox spacing="12" styleClass="match-actions">
                            <Button styleClass="match-action-btn" text="Message" HBox.hgrow="ALWAYS" />
                            <Button styleClass="match-secondary-btn" text="Profile" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>

                    <!-- Match 3 -->
                    <VBox spacing="15" styleClass="match-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <StackPane styleClass="match-avatar-container">
                            <Circle fill="#FF9800" radius="60" />
                            <ImageView fitHeight="100" fitWidth="100" preserveRatio="true" styleClass="match-avatar" />
                            <Circle fill="#4CAF50" radius="10" styleClass="online-indicator" StackPane.alignment="BOTTOM_RIGHT" />
                            <Label styleClass="match-badge new-match-badge" text="NEW" StackPane.alignment="TOP_RIGHT" />
                        </StackPane>
                        <VBox spacing="8" styleClass="match-info">
                            <Label styleClass="match-name" text="Sophia Martinez" />
                            <Label styleClass="match-time" text="Matched 1 week ago" />
                            <Label styleClass="match-interests" text="Yoga Instructor, Reader, Adventurer" wrapText="true" />
                        </VBox>
                        <HBox spacing="12" styleClass="match-actions">
                            <Button styleClass="match-action-btn" text="Message" HBox.hgrow="ALWAYS" />
                            <Button styleClass="match-secondary-btn" text="Profile" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>

                    <!-- Match 4 -->
                    <VBox spacing="15" styleClass="match-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <StackPane styleClass="match-avatar-container">
                            <Circle fill="#9C27B0" radius="60" />
                            <ImageView fitHeight="100" fitWidth="100" preserveRatio="true" styleClass="match-avatar" />
                            <Circle fill="#4CAF50" radius="10" styleClass="online-indicator" StackPane.alignment="BOTTOM_RIGHT" />
                        </StackPane>
                        <VBox spacing="8" styleClass="match-info">
                            <Label styleClass="match-name" text="James Taylor" />
                            <Label styleClass="match-time" text="Matched 2 weeks ago" />
                            <Label styleClass="match-interests" text="Musician, Photographer, Chef" wrapText="true" />
                        </VBox>
                        <HBox spacing="12" styleClass="match-actions">
                            <Button styleClass="match-action-btn" text="Message" HBox.hgrow="ALWAYS" />
                            <Button styleClass="match-secondary-btn" text="Profile" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>

                    <!-- Match 5 -->
                    <VBox spacing="15" styleClass="match-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <StackPane styleClass="match-avatar-container">
                            <Circle fill="#009688" radius="60" />
                            <ImageView fitHeight="100" fitWidth="100" preserveRatio="true" styleClass="match-avatar" />
                        </StackPane>
                        <VBox spacing="8" styleClass="match-info">
                            <Label styleClass="match-name" text="Olivia Parker" />
                            <Label styleClass="match-time" text="Matched 3 weeks ago" />
                            <Label styleClass="match-interests" text="Writer, Runner, Animal Lover" wrapText="true" />
                        </VBox>
                        <HBox spacing="12" styleClass="match-actions">
                            <Button styleClass="match-action-btn" text="Message" HBox.hgrow="ALWAYS" />
                            <Button styleClass="match-secondary-btn" text="Profile" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>
                </GridPane>

                <!-- Recent Conversations -->
                <VBox spacing="20" styleClass="conversations-section">
                    <Label styleClass="subsection-title" text="Recent Conversations" />
                    <VBox spacing="15" styleClass="conversations-list">

                        <!-- Conversation 1 -->
                        <HBox spacing="20" styleClass="conversation-item">
                            <StackPane>
                                <Circle fill="#ec4b6e" radius="30" />
                                <ImageView fitHeight="55" fitWidth="55" preserveRatio="true" styleClass="conversation-avatar" />
                                <Circle fill="#4CAF50" radius="8" styleClass="online-indicator" StackPane.alignment="BOTTOM_RIGHT" />
                            </StackPane>
                            <VBox spacing="6" styleClass="conversation-info">
                                <HBox alignment="CENTER_LEFT" spacing="15">
                                    <Label styleClass="conversation-name" text="Emma Wilson" />
                                    <Label styleClass="conversation-time" text="Just now" />
                                </HBox>
                                <Label styleClass="conversation-preview" text="Hey! Are we still meeting tomorrow? I found a great coffee shop!" wrapText="true" />
                            </VBox>
                        </HBox>

                        <!-- Conversation 2 -->
                        <HBox spacing="20" styleClass="conversation-item">
                            <StackPane>
                                <Circle fill="#2196F3" radius="30" />
                                <ImageView fitHeight="55" fitWidth="55" preserveRatio="true" styleClass="conversation-avatar" />
                            </StackPane>
                            <VBox spacing="6" styleClass="conversation-info">
                                <HBox alignment="CENTER_LEFT" spacing="15">
                                    <Label styleClass="conversation-name" text="David Chen" />
                                    <Label styleClass="conversation-time" text="2 hours ago" />
                                </HBox>
                                <Label styleClass="conversation-preview" text="Thanks for recommending that restaurant! The food was amazing!" wrapText="true" />
                            </VBox>
                        </HBox>

                        <!-- Conversation 3 -->
                        <HBox spacing="20" styleClass="conversation-item">
                            <StackPane>
                                <Circle fill="#FF9800" radius="30" />
                                <ImageView fitHeight="55" fitWidth="55" preserveRatio="true" styleClass="conversation-avatar" />
                                <Circle fill="#4CAF50" radius="8" styleClass="online-indicator" StackPane.alignment="BOTTOM_RIGHT" />
                            </StackPane>
                            <VBox spacing="6" styleClass="conversation-info">
                                <HBox alignment="CENTER_LEFT" spacing="15">
                                    <Label styleClass="conversation-name" text="Sophia Martinez" />
                                    <Label styleClass="conversation-time" text="Yesterday" />
                                </HBox>
                                <Label styleClass="conversation-preview" text="I just finished that book you recommended. We should discuss it over coffee!" wrapText="true" />
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Empty State -->
                <VBox alignment="CENTER" spacing="30" styleClass="matches-empty-state" visible="false">
                    <ImageView fitHeight="150" fitWidth="150" preserveRatio="true" styleClass="matches-empty-state-icon">
                        <Image url="@../icons/match_icon.png" />
                    </ImageView>
                    <Label styleClass="matches-empty-state-text" text="You don't have any matches yet" />
                    <Label styleClass="matches-empty-state-hint" text="Start liking people to discover mutual connections" />
                    <HBox alignment="CENTER" spacing="20">
                        <Button styleClass="action-btn" text="Discover People" />
                        <Button styleClass="secondary-btn" text="View Likes" />
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" prefHeight="30.0" styleClass="status-bar">
            <Label fx:id="statusLabel" styleClass="status-text" text="Matches • 5 total • 3 active • 2 new this week" />
        </HBox>
    </bottom>

</BorderPane>
