<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane fx:id="mainPane" prefHeight="600.0" prefWidth="900.0"
            stylesheets="@../styles/dashboard.css, @../styles/chats.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.tetoo.gui.controllers.DashboardController">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" styleClass="top-bar"
            onMousePressed="#handleMousePressed" 
            onMouseDragged="#handleMouseDragged">
            <ImageView fitHeight="40.0" fitWidth="40.0" preserveRatio="true">
                <Image url="@../images/tetoo_logo_small.png" />
            </ImageView>
            <Label styleClass="app-title" text="TETOO" />
            <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                <Label fx:id="welcomeLabel" styleClass="welcome-text" />
                <Button fx:id="logoutBtn" mnemonicParsing="false" onAction="#handleLogout" 
                        styleClass="logout-btn" text="Logout" />
            </HBox>
        </HBox>
    </top>

    <!-- Left Navigation Bar -->
    <left>
        <VBox prefWidth="200.0" spacing="10.0" styleClass="nav-bar">
            <padding>
                <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
            </padding>

            <!-- User Profile Card -->
            <VBox alignment="CENTER" spacing="10.0" styleClass="profile-card">
                <StackPane>
                    <Circle fill="#FFFFFF" radius="40.0" />
                    <ImageView fx:id="userAvatar" fitHeight="70.0" fitWidth="70.0" preserveRatio="true" />
                </StackPane>
                <Label fx:id="userNameLabel" styleClass="user-name" text="User Name" />
                <Label fx:id="userEmailLabel" styleClass="user-email" />
            </VBox>

            <!-- Navigation Buttons -->
            <VBox spacing="5.0">
                <!-- My Profile -->
                <Button fx:id="profileBtn" mnemonicParsing="false" onAction="#showProfile" 
                        styleClass="nav-btn" text="My Profile">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../icons/profile_icon.png" />
                        </ImageView>
                    </graphic>
                </Button>

                <!-- Chats -->
                <Button fx:id="chatsBtn" mnemonicParsing="false" onAction="#showChats" 
                        styleClass="nav-btn" text="Chats">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../icons/chat_icon.png" />
                        </ImageView>
                    </graphic>
                </Button>

                <!-- Likes -->
                <Button fx:id="likesBtn" mnemonicParsing="false" onAction="#showLikes" 
                        styleClass="nav-btn" text="Likes">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../icons/heart_icon.png" />
                        </ImageView>
                    </graphic>
                </Button>

                <!-- Matches -->
                <Button fx:id="matchesBtn" mnemonicParsing="false" onAction="#showMatches" 
                        styleClass="nav-btn" text="Matches">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../icons/match_icon.png" />
                        </ImageView>
                    </graphic>
                </Button>
            </VBox>
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            
            <!-- Profile content (default) -->
            <VBox fx:id="profileContent" spacing="15.0" visible="true" style="-fx-padding: 20;">
                <Label text="My Profile" styleClass="section-title" />
                <HBox spacing="20.0" alignment="CENTER_LEFT">
                    <ImageView fx:id="profileAvatar" fitHeight="100" fitWidth="100"
                               preserveRatio="true" styleClass="profile-avatar" />
                    <VBox spacing="5.0">
                        <Label fx:id="profileName" styleClass="profile-name" />
                        <Label fx:id="profileAgeLocation" styleClass="profile-info" />
                        <Label fx:id="profileRelationshipGoal" styleClass="profile-info" />
                    </VBox>
                </HBox>
                <VBox spacing="10" style="-fx-padding: 10 0;">
                    <Button mnemonicParsing="false" onAction="#handleEditProfile"
                            styleClass="action-btn" text="Edit Profile" />
                </VBox>
            </VBox>

            <!-- Chats content (hidden by default) -->
            <VBox fx:id="chatsContent" spacing="0" visible="false" StackPane.alignment="CENTER">
                <!-- Include chat panel -->
                <fx:include source="chat_panel.fxml" fx:id="chatPanel" />
            </VBox>

            <!-- Likes content (hidden by default) -->
            <VBox fx:id="likesContent" spacing="15.0" visible="false" style="-fx-padding: 20;">
                <Label text="Likes" styleClass="section-title" />
                <HBox spacing="20.0">
                    <VBox spacing="10.0" styleClass="likes-section">
                        <Label text="Received Likes" styleClass="subsection-title" />
                        <Label fx:id="receivedLikesCount" text="0" styleClass="likes-count" />
                        <Button mnemonicParsing="false" onAction="#handleViewReceivedLikes"
                                styleClass="secondary-btn" text="View All" />
                    </VBox>
                    <VBox spacing="10.0" styleClass="likes-section">
                        <Label text="Sent Likes" styleClass="subsection-title" />
                        <Label fx:id="sentLikesCount" text="0" styleClass="likes-count" />
                        <Button mnemonicParsing="false" onAction="#handleViewSentLikes"
                                styleClass="secondary-btn" text="View All" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- Matches content (hidden by default) -->
            <VBox fx:id="matchesContent" spacing="15.0" visible="false" style="-fx-padding: 20;">
                <Label text="Matches" styleClass="section-title" />
                <Label text="People you've matched with" styleClass="info-text" />
                <Button mnemonicParsing="false" onAction="#handleViewMatches"
                        styleClass="action-btn" text="View All Matches" />
            </VBox>

        </StackPane>
    </center>

    <!-- Bottom Status Bar -->
    <bottom>
        <HBox alignment="CENTER" prefHeight="30.0" styleClass="status-bar">
            <Label fx:id="statusLabel" styleClass="status-text" text="Ready" />
        </HBox>
    </bottom>

</BorderPane>