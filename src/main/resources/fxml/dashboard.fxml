<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainPane" prefHeight="600.0" prefWidth="900.0" 
            stylesheets="@../styles/dashboard.css"
            xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.tetoo.gui.controllers.DashboardController">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" styleClass="top-bar">
            <ImageView fitHeight="40.0" fitWidth="40.0" preserveRatio="true">
                <Image url="@../images/tetoo_logo_small.png" />
            </ImageView>
            <Label text="TETOO" styleClass="app-title" />
            <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                <Label fx:id="welcomeLabel" styleClass="welcome-text" />
                <Button fx:id="logoutBtn" mnemonicParsing="false" onAction="#handleLogout" 
                        styleClass="logout-btn" text="Logout" />
            </HBox>
        </HBox>
    </top>

    <!-- Left Navigation Bar -->
    <left>
        <VBox prefWidth="200.0" spacing="10.0" styleClass="nav-bar">
            <padding>
                <Insets top="20.0" right="10.0" bottom="20.0" left="10.0" />
            </padding>
            
            <!-- User Profile Card -->
            <VBox alignment="CENTER" spacing="10.0" styleClass="profile-card">
                <StackPane>
                    <Circle radius="40.0" fill="#E0E0E0" />
                    <ImageView fx:id="userAvatar" fitHeight="70.0" fitWidth="70.0" 
                               preserveRatio="true" />
                </StackPane>
                <Label fx:id="userNameLabel" styleClass="user-name" text="User Name" />
                <Label fx:id="userEmailLabel" styleClass="user-email" />
            </VBox>

            <!-- Navigation Buttons -->
            <VBox spacing="5.0">
                <Button fx:id="profileBtn" mnemonicParsing="false" onAction="#showProfile" 
                        styleClass="nav-btn" text="My Profile">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../icons/profile_icon.png" />
                        </ImageView>
                    </graphic>
                </Button>
                
                <Button fx:id="discoverBtn" mnemonicParsing="false" onAction="#showDiscover" 
                        styleClass="nav-btn" text="Discover">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../icons/search_icon.png" />
                        </ImageView>
                    </graphic>
                </Button>
                
                <Button fx:id="matchesBtn" mnemonicParsing="false" onAction="#showMatches" 
                        styleClass="nav-btn" text="Matches">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../icons/heart_icon.png" />
                        </ImageView>
                    </graphic>
                </Button>
                
                <Button fx:id="messagesBtn" mnemonicParsing="false" onAction="#showMessages" 
                        styleClass="nav-btn" text="Messages">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../icons/chat_icon.png" />
                        </ImageView>
                    </graphic>
                </Button>
                
                <Button fx:id="settingsBtn" mnemonicParsing="false" onAction="#showSettings" 
                        styleClass="nav-btn" text="Settings">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <Image url="@../icons/settings_icon.png" />
                        </ImageView>
                    </graphic>
                </Button>
            </VBox>
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <!-- Default content (Profile) -->
            <VBox alignment="CENTER" spacing="20.0">
                <Label text="Welcome to TETOO Dashboard" styleClass="content-title" />
                <Label fx:id="defaultContentLabel" text="Select a section from the navigation" 
                       styleClass="content-subtitle" />
                
                <!-- Profile content (default) -->
                <VBox fx:id="profileContent" alignment="CENTER" spacing="15.0" visible="true">
                    <Label text="My Profile" styleClass="section-title" />
                    <Label fx:id="profileInfoLabel" text="Profile information will appear here" 
                           styleClass="info-text" />
                    <Button mnemonicParsing="false" onAction="#handleEditProfile" 
                            styleClass="action-btn" text="Edit Profile" />
                </VBox>
                
                <!-- Discover content (hidden by default) -->
                <VBox fx:id="discoverContent" alignment="CENTER" spacing="15.0" visible="false">
                    <Label text="Discover People" styleClass="section-title" />
                    <Label text="Find and connect with new people" styleClass="info-text" />
                    <Button mnemonicParsing="false" onAction="#handleStartDiscovery" 
                            styleClass="action-btn" text="Start Discovery" />
                </VBox>
                
                <!-- Matches content (hidden by default) -->
                <VBox fx:id="matchesContent" alignment="CENTER" spacing="15.0" visible="false">
                    <Label text="My Matches" styleClass="section-title" />
                    <Label text="People you've matched with" styleClass="info-text" />
                    <Button mnemonicParsing="false" onAction="#handleViewMatches" 
                            styleClass="action-btn" text="View All Matches" />
                </VBox>
                
                <!-- Messages content (hidden by default) -->
                <VBox fx:id="messagesContent" alignment="CENTER" spacing="15.0" visible="false">
                    <Label text="Messages" styleClass="section-title" />
                    <Label text="Your conversations" styleClass="info-text" />
                    <Button mnemonicParsing="false" onAction="#handleViewMessages" 
                            styleClass="action-btn" text="Open Messages" />
                </VBox>
                
                <!-- Settings content (hidden by default) -->
                <VBox fx:id="settingsContent" alignment="CENTER" spacing="15.0" visible="false">
                    <Label text="Settings" styleClass="section-title" />
                    <Label text="Application settings" styleClass="info-text" />
                    <Button mnemonicParsing="false" onAction="#handleOpenSettings" 
                            styleClass="action-btn" text="Open Settings" />
                </VBox>
            </VBox>
        </StackPane>
    </center>

    <!-- Bottom Status Bar -->
    <bottom>
        <HBox alignment="CENTER" prefHeight="30.0" styleClass="status-bar">
            <Label fx:id="statusLabel" text="Ready" styleClass="status-text" />
        </HBox>
    </bottom>

</BorderPane>